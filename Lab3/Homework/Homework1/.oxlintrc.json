{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/no-redundant-roles": "off"
  }
}
